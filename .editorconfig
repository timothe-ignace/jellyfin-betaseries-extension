root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,mjs,html,sh,csproj}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Logging performance rules: not worth the boilerplate at this plugin's log volume.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
